# Simulate CUDA availability so these tests do not require a CUDA installation.
function(check_language language)
  if(NOT language STREQUAL "CUDA")
    message(FATAL_ERROR "Unexpected compiler check for ${language}")
  endif()
  if(NOT expect_cuda)
    message(FATAL_ERROR "CUDA compiler detection was not requested")
  endif()
  set(cuda_checked TRUE PARENT_SCOPE)
  if(cuda_available)
    set(CMAKE_CUDA_COMPILER mock-cuda-compiler PARENT_SCOPE)
  else()
    set(CMAKE_CUDA_COMPILER CMAKE_CUDA_COMPILER-NOTFOUND PARENT_SCOPE)
  endif()
endfunction()

function(enable_language language)
  if(NOT language STREQUAL "CUDA" OR NOT expect_cuda OR NOT cuda_available)
    message(FATAL_ERROR "Unexpected language initialization for ${language}")
  endif()
  set(cuda_enabled TRUE PARENT_SCOPE)
endfunction()
